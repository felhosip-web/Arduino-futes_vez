# Szerver bind, hitelesítés és CORS
PORT=3000
HOST="127.0.0.1"
# Kötelező, ha HOST="0.0.0.0" (ajánlott erős véletlen kulcs, pl. openssl rand -hex 32)
HEATING_API_KEY="csereld-le-eros-veletlen-kulcsra"
FRONTEND_ORIGIN="http://localhost:3000"

# HiveMQ Cloud MQTT (TLS 8883)
MQTT_HOST="your-cluster-id.s1.eu.hivemq.cloud"
MQTT_PORT=8883
MQTT_USER="your_mqtt_username"
MQTT_PASS="your_mqtt_password"
MQTT_CLIENT_ID="backend-futes"
